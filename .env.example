# Eleventy Build Output
SITE_DIR=_site

# Obsidian Vault Blog Sync Configuration
# Path to your Obsidian Vault root directory
# (e.g. "C:/Users/Elaine/Documents/Obsidian/MyVault" or "D:/Notes/ObsidianVault")
OBSIDIAN_VAULT_PATH=""

# Name of the blog folder inside your vault (default is "Site_Blog")
OBSIDIAN_BLOG_DIR="Site_Blog"

# Alternatively, set the direct absolute path to the Site_Blog folder:
# OBSIDIAN_BLOG_PATH="C:/Users/Elaine/Documents/Obsidian/MyVault/Site_Blog"
