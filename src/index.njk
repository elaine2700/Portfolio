---
layout: "layouts/base"
title: "Home"
cssFiles: ["/assets/css/home.css"]
projectsCards: []
---
<article class="home__page">
    <header class="home_hero">
        <h1 class="hero-title">HELLO, I AM ELAINE</h1>
        <div class="hero-description">
            <p>
                A passionate web designer creating sophisticated, immersive digital experiences that blend aesthetics with functionality.
            </p>
        </div>
        <div class="hero-divider"></div>
    </header>

    <div class="home-content-grid">
        <!-- Skills Section -->
        <section class="skills-section">
            <h2 class="section-title">01/ SKILLS</h2>
            <div class="skills-list">
                <div class="skill-category">
                    <h3>WEB DEVELOPMENT</h3>
                    <div class="skill-tags">
                        <span>HTML</span>
                        <span>CSS</span>
                        <span>React</span>
                        <span>Express.js</span>
                        <span>Node.js</span>
                    </div>
                </div>
                
                <div class="skill-category">
                    <h3>DESIGN</h3>
                    <div class="skill-tags">
                        <span>UI/UX</span>
                        <span>Photoshop</span>
                        <span>Illustrator</span>
                        <span>After Effects</span>
                    </div>
                </div>
                
                <div class="skill-category">
                    <h3>XR DEVELOPMENT</h3>
                    <div class="skill-tags">
                        <span>Unity</span>
                        <span>C#</span>
                        <span>Unreal</span>
                        <span>Blueprints</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Selected Works Section -->
        <section class="works-section">
            <h2 class="section-title">02/ SELECTED WORKS</h2>
            <div class="selected-works-list">
                {% set selectedIds = [0, 1, 2] %}
                {% for project in projects %}
                {% if project.id in selectedIds  %}
                <div class="work-item">
                    <div class="work-image-container">
                        <img src="{{project.image}}" alt="{{project.title}} thumbnail">
                    </div>
                    <div class="work-info">
                        <h3 class="work-title">{{project.title}}</h3>
                        {% for tool in project.tools %}
                        <span class="work-tech">{{tool}}</span>
                        {% endfor %}
                        <p class="work-description">{{project.description}}</p>
                    </div>
                </div>
                {% endif %}
                {% endfor %}
            </div>
            
            <div style="margin-top: 4rem; text-align: right;">
                 <a class="button" href="/projects">VIEW ALL PROJECTS -></a>
            </div>
        </section>
    </div>
</article>
