---
layout: "layouts/base"
title: "Home"
cssFiles: ["/assets/css/home.css"]
---
<article class="home__page">

    <!-- HERO SECTION (Digital Collage & Editorial Boldness) -->
    <header class="home_hero">
        <div class="hero-text-side">
            <h1 class="hero-title">HELLO, I AM ELAINE</h1>
            <h2 class="hero-subtitle">FULL STACK DEVELOPER // CREATIVE MIND</h2>
            <p class="hero-paragraph">
                Architecting robust full-stack web applications with an artist’s eye for craft, typography, and motion.
                Bridging technical engineering with expressive visual design to build distinctive digital experiences that
                feel tactile, intentional, and unmistakably human.
            </p>
            <div class="hero-cta-group">
                <a class="button ticket-btn" href="/projects/">EXPLORE PROJECTS -&gt;</a>
                <a class="button ticket-btn teal" href="#contact">CONTACT</a>
                {# Hidden until resume page returns: <a class="button ticket-btn gold" href="/resume/">RESUME DOSSIER</a> #}
            </div>
        </div>

        <div class="hero-collage-side" aria-hidden="true">
            <div class="collage-container">
                <!-- Layer 1: Realistic Torn Paper Assets (Terracotta Rust & Golden Ochre) -->
                <img src="/assets/images/torn-paper-orange.png" alt="" class="collage-torn-paper paper-rust" aria-hidden="true" />
                <img src="/assets/images/torn-paper-yellow.png" alt="" class="collage-torn-paper paper-ochre" aria-hidden="true" />

                <!-- Layer 2: Centerpiece Artwork Plate (Glowing Spatial Wireframe Floating Island in Cyberspace) -->
                <div class="collage-polaroid collage-artwork-plate">
                    <div class="tape-strip tape-polaroid-top"></div>
                    <div class="polaroid-photo-frame">
                        <img src="/assets/images/wireframe-island-cyberspace.jpg" 
                            alt="Complete 3D wireframe floating island in cyberspace with glowing cyan nodes and spatial XYZ coordinates" 
                            class="polaroid-img" />
                    </div>
                </div>

                <!-- Layer 3: Polaroid Avatar Card with Vintage Newspaper Halftone Overlay (Upper-Left) -->
                <div class="collage-polaroid collage-polaroid-card">
                    <div class="tape-strip tape-polaroid-top"></div>
                    <div class="polaroid-photo-frame">
                        <img src="/assets/images/elaine-avatar-newspaper.jpg" 
                             alt="Elaine Serrano - Illustrated Avatar with Newspaper Halftone Effect" 
                             class="polaroid-img" />
                    </div>
                    <div class="polaroid-caption">
                        <span class="polaroid-name">ELAINE SERRANO</span>
                        <span class="polaroid-role">CREATIVE FULL STACK DEV</span>
                    </div>
                </div>

                <!-- Layer 4: Taped Typewriter Note Card (Lower-Right) -->
                <div class="collage-note-card">
                    <div class="tape-strip tape-note-top"></div>
                    <p class="note-quote">
                        "Where solid systems architecture meets tactile visual craftsmanship."
                    </p>
                </div>

                <!-- Layer 5: Retro 8-bit Pixel Cursor -->
                <div class="collage-pixel-cursor" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0 0V19L5 14L9 23L13 21L9 12L15 12L0 0Z" fill="#1E1E1C"/>
                        <path d="M2 3V15.5L5.5 12L8.5 19L10.5 18L7.5 11H12L2 3Z" fill="#FAF7F0"/>
                    </svg>
                </div>
            </div>
        </div>
    </header>

    <!-- SECTION 01: SKILLS & SPECIMENS -->
    <section class="skills-section">
        <h2 class="section-tag">01 // SKILLS</h2>

        <div class="skills-specimens-grid">
            <!-- 01 Web Development -->
            <div class="skills-specimen-card graph-paper">
                <div class="specimen-header">
                    <span class="tag pill">WEB DEV</span>
                </div>
                <h3 class="specimen-title">WEB ARCHITECTURE</h3>
                <div class="tag-group">
                    <span class="tag">HTML5</span>
                    <span class="tag">CSS3 / SCSS</span>
                    <span class="tag">React</span>
                    <span class="tag">Node.js</span>
                    <span class="tag">Express.js</span>
                    <span class="tag">Eleventy</span>
                    <span class="tag">JavaScript</span>
                </div>
            </div>

            <!-- 02 XR & Spatial Development -->
            <div class="skills-specimen-card graph-paper">
                <div class="specimen-header">
                    <span class="tag pill teal">XR DEV</span>
                </div>
                <h3 class="specimen-title">SPATIAL &amp; 3D SYSTEMS</h3>
                <div class="tag-group">
                    <span class="tag">Unity 3D</span>
                    <span class="tag">C#</span>
                    <span class="tag">Unreal Engine</span>
                    <span class="tag">Blueprints</span>
                    <span class="tag">Three.js</span>
                    <span class="tag">WebGL</span>
                    <span class="tag">VR / AR</span>
                </div>
            </div>

            <!-- 03 Visual Design -->
            <div class="skills-specimen-card graph-paper">
                <div class="specimen-header">
                    <span class="tag pill gold">DESIGN</span>
                </div>
                <h3 class="specimen-title">VISUAL &amp; EDITORIAL</h3>
                <div class="tag-group">
                    <span class="tag">UI/UX Design</span>
                    <span class="tag">Figma</span>
                    <span class="tag">Photoshop</span>
                    <span class="tag">Illustrator</span>
                    <span class="tag">After Effects</span>
                    <span class="tag">Typography</span>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 02: SELECTED WORKS (Exhibition Catalog Plates) -->
    <section class="works-section">
        <h2 class="section-tag">02 // SELECTED EXHIBITIONS</h2>

        <div class="catalog-plates-grid">
            {% set selectedIds = [0, 1, 2] %}
            {% for project in projects %}
            {% if project.id in selectedIds %}
            <div class="card">
                <div class="card-header">
                    <span>ARCHIVE #0{{ project.id + 1 }}</span>
                    {% if project.projectType %}
                    <span class="tag pill {{ project.projectType | projectColor }}">
                        {{ project.projectType }}
                    </span>
                    {% endif %}
                </div>

                <div class="plate-image-container corner-tape">
                    <span class="corner-tape-strip tape-tl" aria-hidden="true"></span>
                    <span class="corner-tape-strip tape-tr" aria-hidden="true"></span>
                    <span class="corner-tape-strip tape-bl" aria-hidden="true"></span>
                    <span class="corner-tape-strip tape-br" aria-hidden="true"></span>
                    <div class="image-crop-box">
                        <img src="{{ project.image }}" alt="{{ project.title }} specimen thumbnail" loading="lazy" />
                    </div>
                </div>

                <h3 class="plate-title">{{ project.title }}</h3>

                <div class="tag-group" style="margin-bottom: 0.85rem;">
                    {% for tool in project.tools %}
                    <span class="tag">{{ tool }}</span>
                    {% endfor %}
                </div>

                <p class="plate-description">{{ project.description }}</p>

                <div class="plate-actions">
                    {% if project.content %}
                    <a class="button button-s" href="/projects/{{ project.id }}/">MORE SPECS -&gt;</a>
                    {% endif %}
                    {% if project.linkCode %}
                    <a class="button secondary button-s" href="{{ project.linkCode }}" target="_blank"
                        rel="noopener">CODE &nearr;</a>
                    {% endif %}
                </div>
            </div>
            {% endif %}
            {% endfor %}
        </div>

        <div style="text-align: right; margin-top: 2.5rem;">
            <a class="button ticket-btn teal" href="/projects/">VIEW ALL PROJECT ARCHIVES -&gt;</a>
        </div>
    </section>

</article>