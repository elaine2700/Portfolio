<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Elaine Serrano | {{title}}</title>
    <!--Fonts-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!--CSS-->
    <link rel="stylesheet" href="/assets/css/layout.css"/>
    <link rel="stylesheet" href="/assets/css/global.css"/>
    <link rel="stylesheet" href="/assets/css/footer.css"/>
    {% for css in cssFiles %}
        <link rel="stylesheet" href={{css}} />
    {% endfor %}
    <style>
        /* Temporary inline styles for nav to ensure immediate visual feedback, will move to css later */
        .top-nav {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: flex-start;
            gap: 2rem;
            padding: 1rem 0;
            margin-bottom: 2rem;
            font-family: var(--font-family-headers);
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 0.1em;
        }
        .top-nav a {
            text-decoration: none;
            color: var(--color-text-primary);
            position: relative;
        }
        .top-nav a.active::after {
            content: '>';
            position: absolute;
            left: -15px;
        }
        .top-nav a:hover {
            text-decoration: underline;
        }
        
        
    </style>
</head>
<body>
    {% 
        set navItems = 
        [
            { 'name': 'Home', 'url': '/' },
            { 'name': 'Projects', 'url': '/projects/' }
        ] 
    %}
    <nav class="top-nav">
        {% for item in navItems %}
            <a class="nav-item {% if page.url == item.url %}active{% endif %}" href="{{ item.url }}">{{ item.name }}</a>
        {% endfor %}
    </nav>
    
    <main class="content-wrapper">
        {{content | safe}}
    </main>

    <footer id="contact" class='footer'>   
        <div class="footer-left">
            <p>&copy; 2026 ELAINE SERRANO</p>
        </div>
        <div class="footer-right">
            <p>CONTACT:</p>
            <p>
                <a href="https://www.linkedin.com/in/elaine-serrano-echeverria/">LinkedIn</a>
                &nbsp;
                <a href="https://github.com/elaine2700">Github</a>
            </p>
        </div>
    </footer>

    {% for js in jsFiles %}
    <script src={{js}}></script>
    {% endfor %}
</body>
</html>